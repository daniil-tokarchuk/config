[user]
  email = daniil.v.tokarchuk@gmail.com
  name = Daniil Tokarchuk

[core]
  editor = nvim
	autocrlf = input
[diff]
  tool = nvimdiff
[merge]
  tool = nvimdiff
[mergetool]
  keepBackup = false

[gpg]
  format = ssh
[user]
  signingkey = ~/.ssh/ed.pub
[commit]
  gpgsign = true

[fetch]
  prune = true
[push]
  autoSetupRemote = true
[pull]
  rebase = true

[init]
  defaultBranch = main

[alias]
	h = help
  d = diff
  f = fetch
	b = branch
	s = status
	i = init
	l = log
  sm = submodule
  smfe = sm foreach 
  smu = sm update --remote --merge 

	cl = clone
  ch = cherry-pick

	co = checkout
	cob = co -b
  cos = co staging
  com = co main
  cod = co dev

	a = add
	ap = a -p
	ac = !git a . && git c
	aca = !git a . && git ca
	acan = !git a . && git can
	acanpf = !git a . && git canpf
	acapf = !git a . && git capf
	acp = !git a . && git cp

	c = commit -S
	ca = c --amend
	can = ca --no-edit
	canpf = !git can && git pf
	capf = !git ca && git pf
  cp = !git c && git p

	p = push
	pf = p --force-with-lease
  pl = pull

  rsu = remote set-url origin

  rpf = "!rpf() { \
		echo \"# Checkout & pull -> $2\"; \
		git co $2 && git pl; \
		echo \"# Checkout, pull, rebase & push force -> $1\"; \
		git co $1 && git pl && git rebase $2 && git pf; \
	}; rpf \"$@\""
	rms = "!git rpf main staging"
	rds = "!git rpf dev staging"
	rsd = "!git rpf staging dev"
	rdm = "!git rpf dev main"
	rsm = "!git rpf staging main"
	rmd = "!git rpf main dev"

	ri = rebase -i
	rim = rebase -i main
	ris = rebase -i staging
	rid = rebase -i dev
	ra = rebase --abort
	rc = rebase --continue
  
  r = restore
	rs = restore --staged

  rss = reset --soft

  rev = revert

  sk = stash -u
	sp = stash pop
	sd = stash drop
	sl = stash list

	uiau = update-index --assume-unchanged
	uinau = update-index --no-assume-unchanged

	xu = clean -df   # delete untracked files
	xi = clean -dfX  # delete ignored files
	xui = clean -dfx # delete untracked & ignored files
